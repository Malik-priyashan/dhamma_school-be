# Set these on the backend deployment and in backend/.env for local development.
DATABASE_URL=postgresql://user:password@host:5432/database
JWT_SECRET=replace_with_a_long_random_secret
# Use gmail now; switch to resend after you verify a domain you own.
EMAIL_PROVIDER=gmail
GMAIL_USER=your-account@gmail.com
GMAIL_APP_PASSWORD=your_16_character_google_app_password
# Optional: use STARTTLS on port 587 for local networks that block port 465.
# GMAIL_SMTP_PORT=587

# Keep these for a later move to Resend. Set EMAIL_PROVIDER=resend then.
RESEND_API_KEY=re_replace_with_your_resend_api_key
RESEND_FROM_EMAIL=Dhamma School <verify@your-verified-domain.com>
EMAIL_VERIFICATION_SECRET=replace_with_a_separate_random_secret_at_least_32_characters
